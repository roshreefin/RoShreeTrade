# Kite Connect keys optional (app runs free on yfinance without them)
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# For yfinance fallback (no API key needed, but 15-min delayed data)
USE_YFINANCE_FALLBACK=true

# App Configuration
NIFTY_200_SYMBOLS=^NSEI
NIFTY_500_SYMBOLS=^NSEI
SCAN_INTERVAL_MINUTES=15
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30